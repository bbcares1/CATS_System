# Copy to .env.prod and set these values before the first deployment.
CATS_PROD_DB_PASSWORD=replace-this-database-password
CATS_PROD_ROOT_PASSWORD=replace-this-root-password
CATS_ADMIN_USER=admin
CATS_ADMIN_PASSWORD=replace-this-login-password
CATS_ADMIN_NAME=CATS Administrator
CATS_ADMIN_STAFF_ID=ADMIN
CATS_ADMIN_EMAIL=admin@example.test
CATS_BIND_ADDRESS=127.0.0.1
CATS_HTTP_PORT=8081
CATS_PUBLIC_URL=http://localhost:8081
# SMTP is optional for startup. Configure it to deliver the selected email features.
# Use prod,mail for STARTTLS SMTP, or prod,qqmail for QQ.
CATS_PROFILES=prod
CATS_MAIL_HOST=
CATS_MAIL_PORT=587
CATS_MAIL_USER=
CATS_MAIL_PASSWORD=
CATS_MAIL_FROM=
