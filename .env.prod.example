# Copy to .env.prod, choose your own values, and keep that file out of Git.
CATS_PROD_DB_PASSWORD=choose-a-database-password
CATS_PROD_ROOT_PASSWORD=choose-a-root-password
CATS_ADMIN_USER=admin
CATS_ADMIN_PASSWORD=choose-an-admin-password
CATS_ADMIN_NAME=CATS Administrator
CATS_ADMIN_STAFF_ID=ADMIN
CATS_HTTP_PORT=8081
CATS_BIND_ADDRESS=127.0.0.1
# Optional servlet path, for example /cats; leave blank for the host root.
CATS_CONTEXT_PATH=
