# Settings for the Docker application connected to RDS.
SPRING_PROFILES_ACTIVE=prod
CATS_DB_URL=jdbc:mysql://YOUR_RDS_ENDPOINT:3306/cats-demo?sslMode=REQUIRED&connectionTimeZone=%2B08:00&forceConnectionTimeZoneToSession=true
CATS_DB_USER=YOUR_RDS_USERNAME
CATS_DB_PASSWORD=YOUR_RDS_PASSWORD
CATS_HTTP_PORT=8080
CATS_PUBLIC_URL=http://YOUR_EC2_IP:8081
TZ=Asia/Singapore
JAVA_TOOL_OPTIONS=-Xms64m -Xmx384m -Duser.timezone=Asia/Singapore
